PORT=3000
# Rosters are held in server memory only. Deleted after this much inactivity…
SESSION_IDLE_HOURS=8
# …or this long after upload, whichever comes first.
SESSION_MAX_HOURS=24
# production → Secure cookies + trust proxy (required behind HTTPS hosting)
NODE_ENV=development
# Max simultaneous sessions held in memory (each up to ~5 MB). New visitors get "busy" when full.
MAX_SESSIONS=40
